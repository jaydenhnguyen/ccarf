# ============================================================
# Shared (config.py)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
AGENT_LOG_STDERR=0

# ============================================================
# Lab 01: customer support agent (lab01_customer_support_agent/)
# ============================================================
SIMULATE_LOOKUP_TIMEOUT=0
SIMULATE_CUSTOMER_TIMEOUT=0

# ============================================================
# Lab 02: MCP docs server (lab02_mcp_docs_server/)
# ============================================================
# --- client side (raw_client.py): sent in every message's _meta; the user token is picked at login ---
DOCS_MCP_CLIENT_TOKEN=cli-token-raw-client-01

# --- server side (server.py reads these from this file, not from the env the client gives it) ---
DOCS_MCP_ACCEPTED_CLIENT_TOKEN=cli-token-raw-client-01
DOCS_SERVER_KEY=srv-key-docs-mcp-01
# 1 = skip the client token check and act as DOCS_MCP_DEV_USER_TOKEN (dev only: the Inspector can't send _meta)
DOCS_MCP_DEV_SKIP_CLIENT_AUTH=0
DOCS_MCP_DEV_USER_TOKEN=tok-alice

# --- backend side (backend.py reads it from this file on every call) ---
# 1 = backend.get_doc raises a transient timeout
SIMULATE_BACKEND_TIMEOUT=0